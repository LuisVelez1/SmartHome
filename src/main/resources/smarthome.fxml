<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="org.HomeFunctional.HomeController" style="-fx-background-color:#edf7f7;">
  <top>
    <VBox spacing="5" style="-fx-background-color:#087f83; -fx-padding:20;">
      <Label text="SMART HOME MANAGEMENT" style="-fx-font-size:22; -fx-font-weight:bold; -fx-text-fill:white;"/>
      <Label fx:id="homeTitle" style="-fx-text-fill:white; -fx-font-size:14;"/>
    </VBox>
  </top>
  <center>
    <VBox spacing="14" style="-fx-padding:20;">
      <GridPane hgap="14" vgap="12">
        <columnConstraints><ColumnConstraints percentWidth="50"/><ColumnConstraints percentWidth="50"/></columnConstraints>
        <VBox GridPane.columnIndex="0" spacing="10" style="-fx-background-color:white; -fx-padding:16; -fx-background-radius:10;">
          <Label text="Iluminación" style="-fx-font-size:18; -fx-font-weight:bold;"/>
          <Label fx:id="lightStatus"/>
          <HBox spacing="8"><Button text="Encender" onAction="#lightOn"/><Button text="Apagar" onAction="#lightOff"/></HBox>
        </VBox>
        <VBox GridPane.columnIndex="1" spacing="10" style="-fx-background-color:white; -fx-padding:16; -fx-background-radius:10;">
          <Label text="Climatización" style="-fx-font-size:18; -fx-font-weight:bold;"/>
          <HBox spacing="6"><Label fx:id="thermostatStatus"/><Label fx:id="temperatureStatus"/></HBox>
          <HBox spacing="8"><Button text="Encender" onAction="#thermostatOn"/><Button text="Apagar" onAction="#thermostatOff"/></HBox>
          <ComboBox fx:id="modeSelector" onAction="#changeMode" promptText="Modo de temperatura"/>
        </VBox>
      </GridPane>
      <VBox spacing="8" style="-fx-background-color:white; -fx-padding:16; -fx-background-radius:10;">
        <Label text="Automatización y seguridad" style="-fx-font-size:18; -fx-font-weight:bold;"/>
        <Label fx:id="securityStatus"/>
        <HBox spacing="8"><Button text="Simular movimiento" onAction="#motion"/><Button text="Salir de casa" onAction="#leave"/><Button text="Volver a casa" onAction="#arrive"/></HBox>
      </VBox>
      <HBox spacing="8"><Button text="Encender toda la casa" onAction="#allOn"/><Button text="Apagar toda la casa" onAction="#allOff"/></HBox>
      <Label text="Registro de eventos" style="-fx-font-size:17; -fx-font-weight:bold;"/>
      <TextArea fx:id="eventLog" editable="false" wrapText="true" VBox.vgrow="ALWAYS"/>
    </VBox>
  </center>
</BorderPane>
